# Store as ~/.config/hifiberry-tts/env with mode 0600 (not a shell script).
BIND_ADDR=0.0.0.0:8090
MPD_BIND_ADDR=0.0.0.0:6601
WYOMING_BIND_ADDR=0.0.0.0:10700
# Optional direct text-to-speech server. Host:port, Wyoming TCP (no HTTP URL).
WYOMING_TTS_ADDR=
TTS_VOICE=
# fixed: bounded PCM queue and startup/recovery fill.
# adaptive: estimate arrival rate, receive ahead independently into bounded RAM,
# and wait for completion if slow before start or after the first underrun.
# Adaptive buffering can delay speech substantially for a slow TTS engine.
PCM_BUFFERING_MODE=fixed
# Audio duration, not a wall-clock delay. Requires 0 <= prebuffer <= cap <= 5000.
# In adaptive mode cap limits decoder read-ahead; MAX_AUDIO_BYTES caps PCM input.
PCM_PREBUFFER_MS=250
PCM_BUFFER_MS=1000
API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_24_CHARACTERS

# Empty preserves each audio URL's scheme. http or https forces it for all URLs.
# Path, query and non-default explicit ports are preserved.
FORCE_PROTO=

# A multiplier of existing streams' linear amplitude; 0.25 = -12 dB.
# 1 disables ducking; 0 silences background streams during the announcement.
DUCK_FACTOR=0.25
# * means all currently running playback streams, regardless of player.
# To restrict, use exact application.process.binary values, e.g. mpd,librespot.
DUCK_TARGETS=*
TTS_VOLUME_LEVEL=1.0
# Independent output preamp, -24 to +24 dB. 0 preserves original amplitude.
# +6 is approximately twice the amplitude; applies to all bridge playback.
SPEECH_GAIN_DB=0

# Strongly recommended: exact hostname/IP(s) used in HA's generated audio URLs.
# No scheme/port. Empty allows any HTTP(S) host reachable from this device.
# MEDIA_HOSTS=homeassistant.local,192.168.1.10
# 20MiB accepted PCM per item: ~238s at 44100 Hz/mono/16-bit.
# This is receive capacity, not startup fill. Consumed RAM chunks are released.
MAX_AUDIO_BYTES=20971520
MAX_PLAY_SECONDS=300
# Includes time spent waiting for HA to finish fresh TTS generation.
HTTP_DOWNLOAD_TIMEOUT_SECONDS=120
PW_DUMP_BIN=/usr/bin/pw-dump
PW_CLI_BIN=/usr/bin/pw-cli

# Inherit NG's user PipeWire session. For a nondefault instance only:
# PIPEWIRE_REMOTE=pipewire-0
# PIPEWIRE_RUNTIME_DIR=/run/user/1000
# Optional existing PipeWire node.name (from pw-dump). Empty follows NG default.
# PIPEWIRE_TARGET=speakereq2x2
